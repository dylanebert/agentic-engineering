{
  "name": "agentic-engineering",
  "version": "0.0.0",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@7",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "~6",
    "vite": "8.0.16"
  },
  "private": true,
  "dependencies": {
    "@dylanebert/shallot": "github:dylanebert/shallot#0664218f465224397b80aeb604b51178ac71cfb2",
    "typegpu": "~0.12.5",
    "unplugin-typegpu": "~0.12.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.scripts.json && bun scripts/shallot-carrier.ts check",
    "list": "bun scripts/shallot-carrier.ts list",
    "workflow": "bun scripts/shallot-carrier.ts workflow",
    "test": "bun scripts/shallot-carrier.ts test && bun test ./scripts/figures-manifest.test.ts ./scripts/import-gate.test.ts ./scripts/shot-route.test.ts",
    "shot": "bun run scripts/shot.ts",
    "instrument": "bun run scripts/instrument.ts",
    "runtime": "bun run scripts/runtime.ts",
    "hero": "bun scripts/hero-startup.ts"
  },
  "type": "module"
}
