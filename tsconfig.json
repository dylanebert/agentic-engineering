{
  "extends": [
    "@tsconfig/svelte/tsconfig.json",
    "@dylanebert/shallot/tsconfig.json"
  ],
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client", "bun", "node", "@webgpu/types"],
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "vite.config.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
